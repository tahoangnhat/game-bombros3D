# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Synty Assets - KHÔNG commit package (rất quan trọng)
Assets/SyntyStudios/
Assets/PolygonCity/
Assets/PolygonAdventure/
Assets/PolygonKnights/
Assets/PolygonPrototype/
Assets/_Recovery/   # Optional: nếu không muốn commit file backup

# Meta files của Synty (nếu có)
Assets/SyntyStudios/**/*.meta
Assets/PolygonCity/**/*.meta
Assets/PolygonAdventure/**/*.meta

# Other common ignores
*.log
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
.vs/
.gradle/
ExportedObj/
consulo/
MemoryCaptures/
Recordings/

# Addressables
/Assets/StreamingAssets/aa*
/Assets/AddressableAssetsData/*

# Visual Scripting
/Assets/Unity.VisualScripting.Generated/