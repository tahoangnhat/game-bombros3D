# Unity + backend ignore rules

# Unity generated folders and caches
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity build artifacts and common generated files
*.log
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.user
*.userprefs
*.suo
*.csproj
*.unityproj
*.sln
*.slnx
*.app
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.blend1
*.blend1.meta

# Visual Studio / Rider / IDE cache
.vs/
.idea/
*.DotSettings.user

# Gradle / Java local build outputs
.gradle/
backend/target/

# Unity Addressables / Visual Scripting generated content
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/Addressables_Temp/
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated test scenes and crash files
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# TextMesh Pro example assets. Keep only what your UI actually uses.
Assets/TextMesh Pro/
Assets/TextMesh Pro*.meta

# Synty / Polygon packs. Team should install these locally instead of committing them.
Assets/SyntyStudios/
Assets/SyntyStudios*.meta
Assets/Polygon*/
Assets/Polygon*.meta

# Third-party low-poly asset packs. Keep curated prefabs/materials elsewhere if needed.
Assets/Lowpoly Biome Pack/
Assets/Lowpoly Biome Pack.meta
Assets/Lowpoly Forest Pack Winter/
Assets/Lowpoly Forest Pack Winter.meta

# Recovery / backup content
Assets/_Recovery/
Assets/_Recovery/*.unity
Assets/_Recovery/*.meta

# Optional asset store content
# /[Aa]ssets/AssetStoreTools*
